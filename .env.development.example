# Hosted DEVELOPMENT database with the API and browser running on this computer.
# Copy to .env.development (ignored), then replace the placeholder privately.
# Never use production database credentials here.
LMS_ENVIRONMENT=development
LMS_API_HOST=127.0.0.1
LMS_API_PORT=8000
LMS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://DEVELOPMENT_USER:DEVELOPMENT_PASSWORD@db.prisma.io:5432/postgres?sslmode=require
LMS_DB_POOL_MAX=3
LMS_DB_POOL_MAX_WAITING=10
LMS_DB_ACQUIRE_TIMEOUT=2
LMS_DB_LOCK_TIMEOUT_MS=2000
LMS_DB_STATEMENT_TIMEOUT_MS=5000
LMS_DB_IDLE_TIMEOUT_MS=10000
