# Server-only FastAPI origin. Production uses the exact Render HTTPS origin.
BACKEND_API_URL=http://127.0.0.1:8000
# Canonical dashboard origin; use its exact HTTPS URL in production.
APP_ORIGIN=http://127.0.0.1:3000
# Empty uses the dashboard's own API relay. Never set a hosted backend here.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CSRF_COOKIE_NAME=lms_csrf
